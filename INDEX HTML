<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>PM SHRI HARMUTTY DIKRONG HIGH SCHOOL</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

html{
    scroll-behavior:smooth;
}

body{
    background:#f5fff8;
    color:#173b2a;
}

/* NAVBAR */
header{
    position:sticky;
    top:0;
    z-index:1000;
    background:#ffffff;
    box-shadow:0 3px 15px rgba(0,0,0,.1);
}

.navbar{
    max-width:1200px;
    margin:auto;
    padding:18px 25px;
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.logo{
    font-size:20px;
    font-weight:bold;
    color:#087a3d;
}

.navbar ul{
    list-style:none;
    display:flex;
    gap:25px;
}

.navbar a{
    text-decoration:none;
    color:#17452e;
    font-weight:600;
}

.navbar a:hover{
    color:#08a34d;
}

/* HERO */
.hero{
    min-height:90vh;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:50px 20px;
    background:
    linear-gradient(rgba(0,105,55,.88),rgba(0,70,38,.88)),
    url("https://images.unsplash.com/photo-1562774053-701939374585?auto=format&fit=crop&w=1600&q=80");
    background-size:cover;
    background-position:center;
    color:white;
}

.hero-content{
    max-width:850px;
}

.hero h1{
    font-size:48px;
    line-height:1.15;
    margin-bottom:20px;
}

.hero p{
    font-size:20px;
    margin-bottom:30px;
}

.btn{
    display:inline-block;
    padding:14px 28px;
    background:#ffffff;
    color:#087a3d;
    border-radius:30px;
    text-decoration:none;
    font-weight:bold;
    transition:.3s;
}

.btn:hover{
    transform:translateY(-3px);
    background:#dffff0;
}

/* GENERAL */
section{
    padding:80px 20px;
}

.container{
    max-width:1150px;
    margin:auto;
}

.section-title{
    text-align:center;
    margin-bottom:45px;
}

.section-title h2{
    font-size:36px;
    color:#087a3d;
}

.section-title p{
    margin-top:10px;
    color:#607568;
}

/* ABOUT */
.about{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:40px;
    align-items:center;
}

.about img{
    width:100%;
    border-radius:20px;
    box-shadow:0 10px 30px rgba(0,0,0,.15);
}

.about-text h3{
    font-size:30px;
    margin-bottom:18px;
    color:#087a3d;
}

.about-text p{
    line-height:1.8;
    color:#50665a;
}

/* CARDS */
.cards{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:25px;
}

.card{
    background:white;
    padding:30px;
    border-radius:18px;
    text-align:center;
    box-shadow:0 8px 25px rgba(0,0,0,.08);
    transition:.3s;
}

.card:hover{
    transform:translateY(-8px);
}

.card .icon{
    font-size:45px;
    margin-bottom:15px;
}

.card h3{
    color:#087a3d;
    margin-bottom:10px;
}

.card p{
    color:#65756c;
    line-height:1.6;
}

/* STAFF */
.staff-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:25px;
}

.teacher{
    background:#fff;
    border-radius:18px;
    overflow:hidden;
    box-shadow:0 8px 25px rgba(0,0,0,.1);
    text-align:center;
}

.teacher img{
    width:100%;
    height:260px;
    object-fit:cover;
}

.teacher-info{
    padding:22px;
}

.teacher-info h3{
    color:#087a3d;
    margin-bottom:8px;
}

.teacher-info p{
    color:#65756c;
    line-height:1.5;
}

/* GALLERY */
.gallery{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
}

.gallery img{
    width:100%;
    height:240px;
    object-fit:cover;
    border-radius:15px;
    transition:.3s;
}

.gallery img:hover{
    transform:scale(1.03);
}

/* SPORTS */
.sports{
    background:#eafff2;
}

.sport-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:20px;
}

.sport{
    background:white;
    padding:30px 15px;
    border-radius:18px;
    text-align:center;
    box-shadow:0 6px 20px rgba(0,0,0,.07);
}

.sport h3{
    margin-top:12px;
    color:#087a3d;
}

/* NOTICE */
.notice-box{
    max-width:850px;
    margin:auto;
}

.notice{
    background:white;
    padding:20px;
    margin-bottom:15px;
    border-left:5px solid #087a3d;
    border-radius:8px;
    box-shadow:0 5px 15px rgba(0,0,0,.06);
}

/* CONTACT */
.contact{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:35px;
}

.contact-info{
    background:#087a3d;
    color:white;
    padding:35px;
    border-radius:20px;
}

.contact-info h3{
    font-size:28px;
    margin-bottom:20px;
}

.contact-info p{
    margin:15px 0;
}

form{
    background:white;
    padding:30px;
    border-radius:20px;
    box-shadow:0 8px 25px rgba(0,0,0,.08);
}

input, textarea{
    width:100%;
    padding:14px;
    margin-bottom:15px;
    border:1px solid #d5e5dc;
    border-radius:8px;
    outline:none;
}

textarea{
    height:130px;
    resize:none;
}

button{
    border:none;
    padding:14px 25px;
    border-radius:25px;
    background:#087a3d;
    color:white;
    font-weight:bold;
    cursor:pointer;
}

button:hover{
    background:#065c2e;
}

/* FOOTER */
footer{
    background:#073b22;
    color:white;
    text-align:center;
    padding:30px 20px;
}

footer p{
    margin:8px;
    color:#c8e6d5;
}

/* MOBILE */
@media(max-width:800px){

    .navbar{
        flex-direction:column;
        gap:15px;
    }

    .navbar ul{
        gap:12px;
        flex-wrap:wrap;
        justify-content:center;
    }

    .hero h1{
        font-size:34px;
    }

    .about,
    .contact{
        grid-template-columns:1fr;
    }

    .cards,
    .staff-grid,
    .gallery{
        grid-template-columns:1fr;
    }

    .sport-grid{
        grid-template-columns:repeat(2,1fr);
    }
}
</style>
</head>

